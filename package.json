{
  "name": "pryo-mvp1",
  "version": "0.0.3",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev --filter=@pryo/web",
    "build": "turbo build --filter=@pryo/web",
    "start": "pnpm --filter @pryo/web start",
    "typecheck": "turbo typecheck",
    "check": "pnpm typecheck && pnpm build",
    "worker:start": "pnpm --filter @pryo/worker start"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
